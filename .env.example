# Opcional: copie para .env só se quiser mudar os padrões. Sem .env, o DocuMind usa os
# valores abaixo. Tudo roda localmente no Ollama; não há chave de API.

# Baixe antes com: ollama pull qwen3:14b ; ollama pull qwen3-embedding:0.6b
# qwen3:14b é o padrão por ser mais preciso; qwen3:8b é mais rápido e leve (acertou 45/48
# contra 48/48 do 14b na matriz difícil de 27/09).
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Só endereços desta máquina são aceitos (localhost / 127.0.0.1 / ::1).
DOCUMIND_OLLAMA_URL=http://127.0.0.1:11434

# Segundos de espera por resposta (a primeira inclui carregar o modelo na memória).
DOCUMIND_OLLAMA_TIMEOUT=180

# Raciocínio do Qwen3 antes de responder: mais lento, mais preciso (padrão: true).
DOCUMIND_OLLAMA_THINK=true
